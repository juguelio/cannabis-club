# Base de datos (Postgres). El cluster local descartable de `scripts/dev-db.sh` no es producción.
DATABASE_URL="postgresql://USER@127.0.0.1:55433/club_dev?schema=public"

# Firma de sesiones. En producción: `openssl rand -hex 32`.
AUTH_SECRET="cambiame"

# Origen público del despliegue. De acá salen metadata, sitemap, robots, QR y links de correo.
APP_BASE_URL="http://localhost:3300"

# Identidad que usan los correos (se arman en un cron: no tienen request ni base a mano).
CLUB_NOMBRE="Club de Cultivo"
CLUB_SIGLA="CC"
# Logo absoluto para la cabecera de los correos. Sin esto va un monograma con la sigla.
# CLUB_LOGO_URL="https://tudominio.com/logo.png"

# Correo saliente (Resend). Sin RESEND_API_KEY, los avisos quedan encolados y no se envían.
# RESEND_API_KEY="re_..."
# CLUB_MAIL_FROM="Club de Cultivo <avisos@tudominio.com>"
# CLUB_MAIL_REPLY_TO="contacto@tudominio.com"
# CLUB_MAIL_PRUEBA="pruebas@tudominio.com"

# Baja de la carta: firma los links de un click (`openssl rand -hex 32`).
# BAJA_SECRET="..."

# Cifrado y huella de documentos del legajo. Si se pierden, los documentos ya subidos no se leen.
# DOC_ENC_KEY="..."   # 32 bytes en base64
# DOC_HASH_KEY="..."

# Protección de los endpoints de mantenimiento (cron de avisos, retención).
# CRON_SECRET="..."

# Huella de la base de producción: frena un seed accidental contra esa base.
# PROD_DB_FINGERPRINT="..."
