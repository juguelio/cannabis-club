// Esquema derivado del REA (docs/REA-clubes-europeos.md).
// Regla base: el stock NO es un campo, es la suma de StockMovement. El registro es append-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
  /// Registra entregas en el mostrador: ve padrón y stock, no aprueba altas ni toca configuración.
  DISPENSADOR
  SOCIO
}

enum MemberStatus {
  PENDIENTE
  ACTIVO
  SUSPENDIDO
  BAJA
}

/// Lo que el socio contestó cuando se le preguntó, una vez, si tiene REPROCANN.
/// Nulo = todavía no le preguntamos (el wizard del portal se muestra mientras siga en nulo).
enum ReprocannDeclaracion {
  TIENE
  NO_TIENE
}

enum ReprocannStatus {
  NO_APORTA
  EN_TRAMITE
  VIGENTE
  VENCIDO
  RECHAZADO
}

enum ConsumptionType {
  LUDICO
  TERAPEUTICO
}

enum OriginType {
  SEMILLA
  ESQUEJE
  COSECHA_PROPIA
  PROVEEDOR_EXTERNO
}

enum BatchStage {
  PROPAGACION
  VEGETATIVO
  FLORACION
  COSECHA
  CURADO
  DISPONIBLE
  /// Lote bloqueado: no se puede entregar hasta liberarlo (con motivo auditado).
  CUARENTENA
  AGOTADO
  DESTRUIDO
  /// Retirado del mercado por recall: no se entrega y se avisa a los socios afectados.
  RETIRADO
}

enum MovementType {
  INGRESO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DISPENSACION
  DISPENSACION_REVERSA
  DESTRUCCION
  TRANSFERENCIA
}

/// Cómo llega el producto al socio. Un envío no ocupa turno: no viene al club.
enum DeliveryMode {
  RETIRO
  ENVIO
}

enum PickupStatus {
  SOLICITADA
  CONFIRMADA
  RETIRADA
  VENCIDA
  CANCELADA
}

enum AppointmentStatus {
  PENDIENTE
  CONFIRMADO
  ATENDIDO
  AUSENTE
  CANCELADO
}

enum SignatureType {
  /// La entrega la registró el operador. NO es evidencia de recepción del socio.
  REGISTRO_OPERADOR
  PIN
  FIRMA_DIGITAL
  QR
}

/// Días en que el dispensario no atiende: no se pueden reservar turnos ni retiros.
model ClosedDay {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())
}

/// Configuración del club. Los topes son configuración, no constantes:
/// el default europeo es 25 g/día, 50 g/mes, 30 g y <=10% THC para menores de 21.
model Club {
  id                       String   @id @default("singleton")
  nombre                   String
  /// Nombre corto para el rail y el portal; el `nombre` largo va en libros y comprobantes.
  nombreCorto              String?
  cuit                     String?
  reprocannNumber          String?
  reprocannCode            String?
  directorMedico           String?
  /// Matrícula del director médico: la exige la Res. 1780/2025 y va en el informe semestral.
  directorMedicoMatricula  String?
  responsableTecnico       String?
  /// Título habilitante del responsable técnico (farmacéutico, bioquímico, etc.).
  responsableTecnicoTitulo String?
  /// Personería jurídica: número y fecha de resolución (IGJ o registro provincial).
  personeria               String?
  /// REPS: inscripción provincial en el registro de cannabis.
  reps                     String?
  domicilioLegal           String?
  limiteDiarioG            Decimal  @default(25) @db.Decimal(6, 2)
  limiteMensualG           Decimal  @default(50) @db.Decimal(6, 2)
  /// Con cuántos días de anticipación se avisa que el REPROCANN vence.
  avisoReprocannDias       Int      @default(30)
  limiteMenorG             Decimal  @default(30) @db.Decimal(6, 2)
  edadMinima               Int      @default(18)
  edadLimiteMenor          Int      @default(21)
  thcMaxMenor              Decimal? @db.Decimal(5, 2)
  maxSocios                Int      @default(500)
  requiereReprocann        Boolean  @default(true)
  timezone                 String   @default("America/Argentina/Buenos_Aires")
  /// Aporte de cultivo por gramo (prorrateo de costos, NO precio de venta).
  aportePorGramo           Decimal? @db.Decimal(10, 2)
  /// Cuota social mensual (prorrateo de costos fijos, NO precio).
  cuotaSocialArs           Decimal? @db.Decimal(12, 2)
  /// Cuota de ingreso, si el club la cobra.
  cuotaIngresoArs          Decimal? @db.Decimal(12, 2)
  /// Exigir liberación firmada del lote antes de entregar (REA 5.1).
  requiereLiberacion       Boolean  @default(true)
  /// Datos para transferir el aporte (alias, CBU, titular, banco). Validada por src/lib/comprobante-rules.ts.
  cobro                    Json?
  /// Marca del club (colores, tipografías, textos del sitio). Validada por src/lib/brand.ts; null = aspecto por defecto.
  marca                    Json?
  /// Economía del club: gramos por membresía, aporte, máximo por envío, zonas y productos. Ver src/lib/precios.ts.
  precios                  Json?
  /// Imágenes de marca como data URL (png/jpeg/webp), servidas por /api/marca/<tipo>.
  marcaLogo                String?  @db.Text
  marcaEmblema             String?  @db.Text
  marcaPortada             String?  @db.Text
  /// Sube con cada cambio de marca: invalida la caché de las imágenes.
  marcaVersion             Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

enum AccountKind {
  CARGO
  PAGO
}

enum AccountConcept {
  CUOTA_SOCIAL
  CUOTA_INGRESO
  APORTE_CULTIVO
  AJUSTE
}

/// Cuenta corriente del socio: libro append-only. Corregir es contra-asiento (`reversalOfId`),
/// nunca editar ni borrar. El saldo es la suma con signo de los asientos.
model AccountEntry {
  id             String         @id @default(cuid())
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           AccountKind
  concept        AccountConcept
  amountArs      Decimal        @db.Decimal(12, 2)
  /// Período `YYYY-MM` cuando el asiento es periódico (cuota social).
  period         String?
  occurredAt     DateTime       @default(now())
  /// Un aporte de cultivo nace de una entrega concreta, y sólo uno por entrega.
  dispensationId String?        @unique
  note           String?
  createdById    String?
  creator        User?          @relation("AccountEntryCreator", fields: [createdById], references: [id])
  /// Asiento que este revierte (contra-asiento).
  reversalOfId   String?        @unique
  voidedAt       DateTime?
  createdAt      DateTime       @default(now())

  @@unique([memberId, concept, period])
  @@index([memberId, occurredAt])
}

/// Cierre mensual firmado: congela los totales del período con la firma de quien lo cierra.
/// Append-only: corregir es un cierre nuevo que declara cuál reemplaza (`supersedesId`).
/// Informe semestral en carácter de declaración jurada (Res. 1780/2025): plantas totales y en
/// floración, variedades y actividad del semestre, congelado con firma y huella.
model SemesterReport {
  id           String   @id @default(cuid())
  /// Período `AAAA-S1` (enero-junio) o `AAAA-S2` (julio-diciembre).
  period       String   @unique
  payload      Json
  hash         String
  signedById   String
  signer       User     @relation("SemesterSigner", fields: [signedById], references: [id])
  signedAt     DateTime @default(now())
  note         String?
  /// Informe que reemplaza, si este corrige uno anterior.
  supersedesId String?  @unique
  createdAt    DateTime @default(now())

  @@index([signedAt])
}

model MonthlyClose {
  id           String   @id @default(cuid())
  /// Período `YYYY-MM`.
  period       String   @unique
  payload      Json
  /// Huella SHA-256 del contenido: si alguien toca el payload, deja de cerrar.
  hash         String
  signedById   String
  signer       User     @relation("CloseSigner", fields: [signedById], references: [id])
  signedAt     DateTime @default(now())
  note         String?
  supersedesId String?  @unique
  createdAt    DateTime @default(now())

  @@index([signedAt])
}

/// Consentimiento por finalidad: se registra y se revoca por separado (REA 4).
enum ConsentPurpose {
  DATOS_PERSONALES
  SALUD
  IMAGEN
  COMUNICACIONES
}

model Consent {
  id          String         @id @default(cuid())
  memberId    String
  member      Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  purpose     ConsentPurpose
  version     String
  grantedAt   DateTime       @default(now())
  grantedById String?
  grantedBy   User?          @relation("ConsentGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?
  note        String?
  createdAt   DateTime       @default(now())

  @@unique([memberId, purpose, version])
  @@index([memberId, purpose])
}

/// Motivos por los que el club le escribe a un socio (REA 5).
enum NoticeKind {
  VALIDACION_PENDIENTE
  REPROCANN_VENCIDO
  REPROCANN_NO_VIGENTE
  REPROCANN_POR_VENCER
  REPROCANN_SIN_FECHA
  CONSENTIMIENTO_FALTANTE
  RESERVA_SIN_RETIRAR
  CUENTA_CON_SALDO
  DOCUMENTO_SIN_VERIFICAR
  /// La carta del club (editorial), no un aviso de trámite: otro tono y otra base legal.
  CARTA_CLUB
}

enum NoticeChannel {
  WHATSAPP
  LLAMADO
  PRESENCIAL
  EMAIL
}

/// Registro de avisos: append-only. Sirve para no avisar dos veces lo mismo y para mostrar
/// quién avisó, cuándo y por qué canal. El envío real no lo hace la app: lo hace una persona
/// desde su WhatsApp (ver docs/avisos.md).
/// El socio transfiere el aporte y sube la foto del comprobante; el club lo mira y decide.
/// Sin aprobación del comprobante la reserva no se confirma: no hay cobro automático ni pasarela.
enum PaymentProofStatus {
  EN_REVISION
  APROBADO
  RECHAZADO
}

model PaymentProof {
  id           String             @id @default(cuid())
  pickupId     String
  pickup       PickupRequest      @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  /// Lo que el socio declara haber transferido. Se compara con `PickupRequest.aporteEstimado`.
  montoArs     Decimal?           @db.Decimal(12, 2)
  referencia   String?
  mime         String
  size         Int
  sha256       String
  /// El archivo se guarda cifrado (AES-256-GCM), igual que los documentos del legajo.
  iv           Bytes
  tag          Bytes
  data         Bytes
  status       PaymentProofStatus @default(EN_REVISION)
  uploadedById String?
  reviewedById String?
  reviewedAt   DateTime?
  motivo       String?
  createdAt    DateTime           @default(now())

  @@index([pickupId, createdAt])
  @@index([status])
}

model NoticeLog {
  id        String        @id @default(cuid())
  /// Episodio del aviso (mismo motivo, mismo hecho): un problema nuevo no queda tapado por el aviso viejo.
  episode   String?
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind      NoticeKind
  channel   NoticeChannel
  sentAt    DateTime      @default(now())
  /// Quién lo mandó. Vacío cuando lo mandó el trabajo automático de vencimientos.
  byId      String?
  by        User?         @relation("NoticeSender", fields: [byId], references: [id])
  /// Aviso generado por el cron (email al socio), no por una persona desde la cola.
  automatic Boolean       @default(false)
  note      String?
  createdAt DateTime      @default(now())

  @@index([memberId, kind, sentAt])
  @@index([sentAt])
}

model User {
  id                 String           @id @default(cuid())
  /// Cambiar la clave (o restablecerla) sube la versión: los tokens viejos dejan de valer.
  tokenVersion       Int              @default(0)
  /// Clave temporal entregada en el mostrador: hay que cambiarla y vence.
  mustChangePassword Boolean          @default(false)
  passwordChangedAt  DateTime?
  closes             MonthlyClose[]   @relation("CloseSigner")
  semesterReports    SemesterReport[] @relation("SemesterSigner")
  consents           Consent[]        @relation("ConsentGrantor")
  noticesSent        NoticeLog[]      @relation("NoticeSender")
  cartasCreadas      EdicionCarta[]   @relation("CartaCreador")
  cartasAprobadas    EdicionCarta[]   @relation("CartaAprobador")
  accountEntries     AccountEntry[]   @relation("AccountEntryCreator")
  email              String           @unique
  name               String
  /// Nulo cuando la cuenta se creó con Google: no hay clave que verificar.
  passwordHash       String?
  /// Identidad de Google (`sub`), estable aunque la persona cambie de email.
  googleSub          String?          @unique
  role               Role             @default(OPERADOR)
  active             Boolean          @default(true)
  memberId           String?          @unique
  member             Member?          @relation(fields: [memberId], references: [id])
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())

  movements           StockMovement[]      @relation("MovementActor")
  appointments        Appointment[]        @relation("AppointmentOperator")
  dispensations       Dispensation[]       @relation("DispensationOperator")
  voided              Dispensation[]       @relation("DispensationVoider")
  audits              AuditLog[]
  transports          Transport[]
  shipments           Shipment[]           @relation("ShipmentCreator")
  accessRequest       AccessRequest?
  reviewedRequests    AccessRequest[]      @relation("AccessReviewer")
  verificationReviews MemberVerification[] @relation("VerificationReviewer")
}

enum EstadoCarta {
  BORRADOR
  APROBADA
  ENVIANDO
  ENVIADA
  CANCELADA
}

/**
 * Una edición de la carta del club: el contenido que se aprueba, cuándo sale y cuántos la recibieron.
 * El contenido se guarda como JSON y se arma con `plantillaCarta`, no como HTML: el diseño vive en
 * código y la base guarda los datos. Así una carta vieja se puede volver a dibujar con la plantilla
 * del día sin quedar congelada en un HTML que ya no se toca.
 */
model EdicionCarta {
  id             String      @id @default(cuid())
  /// Cómo se llama la edición para el club: «noviembre 2026».
  edicion        String
  titulo         String
  copete         String
  /// Párrafos de apertura (string[]).
  apertura       Json
  /// Bloques con título, texto y enlace opcional (BloqueCarta[]).
  bloques        Json
  /// Botón principal (texto + url) o vacío.
  cta            Json?
  estado         EstadoCarta @default(BORRADOR)
  /// Cuándo la puede tomar el cron. Es lo que el club programa, no cuándo se aprobó.
  programadaPara DateTime?
  enviadaEn      DateTime?
  creadaPorId    String?
  creadaPor      User?       @relation("CartaCreador", fields: [creadaPorId], references: [id], onDelete: SetNull)
  /// Quién dijo «esto sale». Sin esto la carta no se manda: es el registro que pide la asamblea.
  aprobadaPorId  String?
  aprobadaPor    User?       @relation("CartaAprobador", fields: [aprobadaPorId], references: [id], onDelete: SetNull)
  aprobadaEn     DateTime?
  /// Cuántos socios entraban en el padrón consentido al momento de aprobar.
  alcanzados     Int         @default(0)
  enviados       Int         @default(0)
  errores        Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([estado, programadaPara])
  @@index([createdAt])
}

model Member {
  id                   String                @id @default(cuid())
  account              AccountEntry[]
  shipmentItems        ShipmentItem[]
  legajo               Int                   @unique
  firstName            String
  lastName             String
  docType              String                @default("DNI")
  /// Huella HMAC-SHA256 del documento normalizado: el número no se archiva (REA 4).
  docHash              String?               @unique
  /// Últimos 4 dígitos, para verificar en el mostrador sin exponer el número.
  docLast4             String?
  docVerifiedAt        DateTime?
  /// Nulo mientras el socio no declaró su fecha de nacimiento (socios importados del padrón en papel).
  birthDate            DateTime?             @db.Date
  address              String?
  /// Localidad y provincia: sin ellas la dirección no sirve para despachar (lo marcó el JEV del padrón).
  locality             String?
  province             String?
  postalCode           String?
  phone                String?
  email                String?
  status               MemberStatus          @default(PENDIENTE)
  statusReason         String?
  admittedAt           DateTime?             @db.Date
  leftAt               DateTime?             @db.Date
  reprocannNumber      String?
  reprocannStatus      ReprocannStatus       @default(NO_APORTA)
  reprocannExpiresAt   DateTime?             @db.Date
  consumptionType      ConsumptionType       @default(LUDICO)
  monthlyForecastG     Decimal?              @db.Decimal(6, 2)
  consentSignedAt      DateTime?
  consentVersion       String?
  /// Estado de la re-validación de DNI + REPROCANN. Sólo VERIFICADO habilita reservar y retirar.
  verificationStatus   VerificationStatus    @default(PENDIENTE)
  verificationAt       DateTime?
  /// Respuesta a «¿tenés REPROCANN?». Se pregunta una vez y el socio puede corregirla.
  reprocannDeclaracion ReprocannDeclaracion?
  reprocannAskedAt     DateTime?
  verifications        MemberVerification[]
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user          User?
  appointments  Appointment[]
  pickups       PickupRequest[]
  dispensations Dispensation[]
  movements     StockMovement[]
  transports    Transport[]     @relation("TransportDriver")
  consents      Consent[]
  notices       NoticeLog[]
  accessRequest AccessRequest?

  @@index([status])
  @@index([lastName, firstName])
}

model Strain {
  id          String       @id @default(cuid())
  name        String       @unique
  genetics    String?
  thcPct      Decimal?     @db.Decimal(5, 2)
  cbdPct      Decimal?     @db.Decimal(5, 2)
  active      Boolean      @default(true)
  /// Foto del producto para el catálogo (JPEG/PNG/WEBP). Sin foto se muestra un recuadro provisorio.
  fotoData    Bytes?
  fotoMime    String?
  fotoVersion Int          @default(0)
  batches     Batch[]
  pickupItems PickupItem[]
}

/// Qué variedades y cuántos gramos eligió el socio.
///
/// La reserva antes guardaba sólo el total («15 g») y el club decidía qué preparar. Con el detalle,
/// el socio elige su combo y el club arma exactamente eso. El nombre de la cepa se congela: si la
/// variedad se renombra o se da de baja, la reserva vieja sigue diciendo lo mismo que dijo.
model PickupItem {
  id         String        @id @default(cuid())
  pickupId   String
  pickup     PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)
  strainId   String
  strain     Strain        @relation(fields: [strainId], references: [id])
  strainName String
  grams      Decimal       @db.Decimal(10, 2)

  @@unique([pickupId, strainId])
  @@index([pickupId])
}

model Batch {
  id                    String     @id @default(cuid())
  code                  String     @unique
  strainId              String
  strain                Strain     @relation(fields: [strainId], references: [id])
  originType            OriginType @default(SEMILLA)
  originProviderName    String?
  originProviderAddress String?
  originReference       String?
  plantsCount           Int?
  room                  String?
  stage                 BatchStage @default(PROPAGACION)
  plantedAt             DateTime?  @db.Date
  harvestedAt           DateTime?  @db.Date
  wetWeightG            Decimal?   @db.Decimal(10, 2)
  dryWeightG            Decimal?   @db.Decimal(10, 2)
  thcPct                Decimal?   @db.Decimal(5, 2)
  cbdPct                Decimal?   @db.Decimal(5, 2)
  notes                 String?
  /// Liberación para entregar: nada sale de un lote sin que alguien firme que está apto.
  releasedAt            DateTime?
  releasedById          String?
  releaseNote           String?
  /// Ficha técnica: laboratorio y resultado. Sin análisis, la ficha lo dice.
  labName               String?
  labDate               DateTime?  @db.Date
  labResult             String?
  /// Muestra de retención: cuánto y hasta cuándo se guarda.
  sampleRetainedG       Decimal?   @db.Decimal(10, 2)
  sampleUntil           DateTime?  @db.Date
  /// Recall activo: el lote se retira del mercado y se avisa a quien lo recibió.
  recalledAt            DateTime?
  recallReason          String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  movements     StockMovement[]
  dispensations Dispensation[]
  shipmentItems ShipmentItem[]

  @@index([stage])
  @@index([strainId])
}

/// Libro de movimientos: append-only. Corregir = contra-asiento (reversalOfId), nunca UPDATE.
model StockMovement {
  id             String         @id @default(cuid())
  batchId        String
  batch          Batch          @relation(fields: [batchId], references: [id])
  type           MovementType
  grams          Decimal        @db.Decimal(10, 2)
  reason         String?
  occurredAt     DateTime       @default(now())
  actorId        String
  actor          User           @relation("MovementActor", fields: [actorId], references: [id])
  memberId       String?
  member         Member?        @relation(fields: [memberId], references: [id])
  dispensationId String?        @unique
  dispensation   Dispensation?  @relation(fields: [dispensationId], references: [id])
  transportId    String?
  transport      Transport?     @relation(fields: [transportId], references: [id])
  reversalOfId   String?        @unique
  reversalOf     StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy     StockMovement? @relation("Reversal")
  createdAt      DateTime       @default(now())

  @@index([batchId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([type])
}

model Dispensation {
  id             String         @id @default(cuid())
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id])
  batchId        String
  batch          Batch          @relation(fields: [batchId], references: [id])
  grams          Decimal        @db.Decimal(10, 2)
  thcPct         Decimal?       @db.Decimal(5, 2)
  occurredAt     DateTime       @default(now())
  operatorId     String
  operator       User           @relation("DispensationOperator", fields: [operatorId], references: [id])
  signatureType  SignatureType  @default(PIN)
  signatureRef   String?
  /// Snapshot del cálculo de límites al momento de entregar (defensa posterior).
  limitSnapshot  Json
  notes          String?
  /// Clave del intento de entrega: reintentar la misma intención no duplica el asiento.
  idempotencyKey String?        @unique
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?          @relation("DispensationVoider", fields: [voidedById], references: [id])
  voidReason     String?
  movement       StockMovement?
  appointment    Appointment?
  pickup         PickupRequest?
  shipmentItem   ShipmentItem?

  @@index([memberId, occurredAt])
  @@index([batchId])
}

enum ShipmentMode {
  AEREO
  TERRESTRE
}

enum ShipmentStatus {
  PREPARACION
  DESPACHADO
  ENTREGADO
  CANCELADO
}

/// Traslado de materia vegetal a pacientes que no retiran en sede (República entrega a distancia).
/// No crea stock: el traslado mueve lo ya dispensado por `ShipmentItem.dispensationId`.
model Shipment {
  id          String         @id @default(cuid())
  code        String         @unique
  mode        ShipmentMode   @default(TERRESTRE)
  status      ShipmentStatus @default(PREPARACION)
  fromAddress String
  toAddress   String
  carrierName String
  /// Quién traslada (documento del transportista o de la persona que lleva).
  carrierDoc  String?
  plannedAt   DateTime?
  departedAt  DateTime?
  deliveredAt DateTime?
  /// Constancia del aviso previo a la autoridad (Res. 1780/2025), si corresponde.
  noticeRef   String?
  notes       String?
  createdById String
  createdBy   User           @relation("ShipmentCreator", fields: [createdById], references: [id])
  items       ShipmentItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, plannedAt])
}

/// Un paciente dentro del traslado: qué lote, cuántos gramos, con qué DDJJ firmada.
model ShipmentItem {
  id              String         @id @default(cuid())
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member         @relation(fields: [memberId], references: [id])
  batchId         String
  batch           Batch          @relation(fields: [batchId], references: [id])
  grams           Decimal        @db.Decimal(10, 2)
  /// La DDJJ por paciente es lo que se muestra a la autoridad: sin fecha, el traslado no sale.
  ddjjSignedAt    DateTime?
  ddjjNote        String?
  dispensationId  String?        @unique
  dispensation    Dispensation?  @relation(fields: [dispensationId], references: [id])
  /// Intento de entrega: si la anterior se anula, la nueva usa otra clave de idempotencia.
  attempt         Int            @default(1)
  note            String?
  /// Si el ítem viene de un pedido de envío del portal, entregarlo cierra esa reserva.
  pickupRequestId String?        @unique
  pickupRequest   PickupRequest? @relation(fields: [pickupRequestId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([memberId])
  @@index([batchId])
}

model Transport {
  id          String          @id @default(cuid())
  occurredAt  DateTime        @default(now())
  fromAddress String
  toAddress   String
  grams       Decimal         @db.Decimal(10, 2)
  strainIds   Json?
  driverId    String
  driver      Member          @relation("TransportDriver", fields: [driverId], references: [id])
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  notes       String?
  movements   StockMovement[]

  @@index([occurredAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Franjas de atención del dispensario. Hora local del club (weekday 0 = domingo).
model ScheduleRule {
  id        String   @id @default(cuid())
  weekday   Int
  startMin  Int
  endMin    Int
  slotMin   Int      @default(20)
  capacity  Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([weekday, startMin])
  @@index([weekday])
}

/// Turno reservado por un socio. Reservar no habilita la entrega: el dispensario
/// vuelve a validar REPROCANN y topes al momento de entregar.
model Appointment {
  id             String            @id @default(cuid())
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id])
  scheduledAt    DateTime
  durationMin    Int               @default(20)
  status         AppointmentStatus @default(PENDIENTE)
  channel        String            @default("MOSTRADOR")
  notes          String?
  operatorId     String?
  operator       User?             @relation("AppointmentOperator", fields: [operatorId], references: [id])
  createdById    String?
  attendedAt     DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  dispensationId String?           @unique
  dispensation   Dispensation?     @relation(fields: [dispensationId], references: [id])
  pickup         PickupRequest?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([memberId, scheduledAt])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

/// Reserva de retiro hecha por el socio desde el portal.
/// No es una venta: el club prorratea su costo de cultivo y el retiro se hace en el club,
/// con el mismo chequeo de REPROCANN y topes que una entrega de mostrador.
model PickupRequest {
  id                    String         @id @default(cuid())
  memberId              String
  member                Member         @relation(fields: [memberId], references: [id])
  grams                 Decimal        @db.Decimal(10, 2)
  status                PickupStatus   @default(SOLICITADA)
  appointmentId         String?        @unique
  appointment           Appointment?   @relation(fields: [appointmentId], references: [id])
  /// Aporte estimado congelado al reservar (costo por gramo x gramos).
  aportePorGramo        Decimal?       @db.Decimal(10, 2)
  aporteEstimado        Decimal?       @db.Decimal(12, 2)
  /// Foto del cálculo de topes al reservar, para poder explicar después.
  limitSnapshot         Json?
  /// RETIRO: viene al club con turno. ENVIO: se despacha a su domicilio, sin turno.
  deliveryMode          DeliveryMode   @default(RETIRO)
  /// Copia de la dirección al momento de pedir: el envío tiene que conservar la que se usó.
  deliveryAddress       String?
  deliveryZona          String?
  deliveryDemora        String?
  deliveryTransportista String?
  deliveryCostoArs      Decimal?       @db.Decimal(10, 2)
  shipmentItem          ShipmentItem?
  /// Comprobantes de la transferencia del aporte. El último manda; los rechazados quedan como historial.
  paymentProofs         PaymentProof[]
  notes                 String?
  confirmedAt           DateTime?
  fulfilledAt           DateTime?
  canceledAt            DateTime?
  cancelReason          String?
  dispensationId        String?        @unique
  dispensation          Dispensation?  @relation(fields: [dispensationId], references: [id])
  /// Detalle del pedido: qué variedades y cuántos gramos de cada una. `grams` es el total.
  items                 PickupItem[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([memberId, createdAt])
  @@index([status, createdAt])
}

/// Solicitud de alta: el expediente que llena la persona después de entrar con Google.
/// No es un socio todavía; sólo cuando el club aprueba se crea el legajo.
model AccessRequest {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  birthDate          DateTime            @db.Date
  phone              String
  address            String
  locality           String?
  docType            String              @default("DNI")
  /// Huella del documento: sirve para detectar duplicados sin archivar el número en claro.
  docHash            String
  docLast4           String
  /// Número completo cifrado (AES-256-GCM): se descifra sólo al crear el legajo.
  docNumberCipher    Bytes?
  reprocannNumber    String
  reprocannExpiresAt DateTime            @db.Date
  consumptionType    ConsumptionType     @default(LUDICO)
  /// DDJJ del solicitante y versión del texto aceptado.
  affidavitAccepted  Boolean             @default(false)
  affidavitVersion   String?
  status             AccessRequestStatus @default(PENDIENTE)
  submittedAt        DateTime            @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?               @relation("AccessReviewer", fields: [reviewedById], references: [id])
  rejectionReason    String?
  memberId           String?             @unique
  member             Member?             @relation(fields: [memberId], references: [id])
  documents          AccessDocument[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, submittedAt])
}

/// Archivo del legajo (DNI frente/dorso, credencial REPROCANN). Cifrado en reposo:
/// en la base sólo hay ciphertext; el mime, el tamaño y la huella quedan para poder auditar.
model AccessDocument {
  id         String        @id @default(cuid())
  requestId  String
  request    AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tipo       String
  mime       String
  size       Int
  sha256     String
  iv         Bytes
  tag        Bytes
  data       Bytes
  uploadedAt DateTime      @default(now())

  @@index([requestId])
}

/// Re-validación de un socio que ya existe en el padrón (importado en papel, o vencido el trámite).
/// Es un expediente aparte del alta: no crea el legajo, lo actualiza. Rechazado no se edita: se
/// presenta uno nuevo con `supersedesId`, igual que el resto de los libros.
model MemberVerification {
  id                 String                 @id @default(cuid())
  memberId           String
  member             Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status             VerificationStatus     @default(EN_REVISION)
  /// Lo que declaró el socio (la fuente es el documento; esto es su dicho hasta que el club mire).
  docNumberCipher    Bytes
  docHash            String
  docLast4           String
  birthDate          DateTime               @db.Date
  reprocannNumber    String
  reprocannExpiresAt DateTime               @db.Date
  /// Cómo quiere recibir y a dónde: se declara acá y sólo pasa al legajo al aprobar.
  deliveryMode       DeliveryMode           @default(RETIRO)
  address            String?
  locality           String?
  province           String?
  postalCode         String?
  submittedAt        DateTime               @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?                  @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  rejectionReason    String?
  supersedesId       String?                @unique
  supersedes         MemberVerification?    @relation("VerificationSupersede", fields: [supersedesId], references: [id])
  replaces           MemberVerification?    @relation("VerificationSupersede")
  documents          VerificationDocument[]

  @@index([memberId, submittedAt])
  @@index([status, submittedAt])
}

/// Archivo de la re-validación: mismo cifrado en reposo que los documentos del alta.
model VerificationDocument {
  id             String             @id @default(cuid())
  verificationId String
  verification   MemberVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  tipo           String
  mime           String
  size           Int
  sha256         String
  iv             Bytes
  tag            Bytes
  data           Bytes
  uploadedAt     DateTime           @default(now())

  @@index([verificationId])
}

/// En qué está la re-validación del legajo. Un socio importado entra PENDIENTE: sin DNI ni REPROCANN
/// verificados no puede reservar ni retirar, aunque su ficha exista desde antes.
enum VerificationStatus {
  PENDIENTE
  EN_REVISION
  VERIFICADO
  RECHAZADO
}

enum AccessRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}
